BINANCE_VISION_URL=https://data.binance.vision/data/
BINANCE_VISION_SPOT_LIST_URL=https://s3-ap-northeast-1.amazonaws.com/data.binance.vision?delimiter=/&prefix=data/spot/daily/klines/
LOG_LEVEL=info

# Analyse fondamentale (phase B)
# FRED : clé gratuite -> https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# CoinGecko : clé "demo" optionnelle (relève le quota) -> https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# ACLED : conflits armés structurés. Pas de clé API : compte myACLED + OAuth.
# Crée un compte gratuit -> https://acleddata.com/register puis mets tes identifiants :
ACLED_EMAIL=
ACLED_PASSWORD=

# Cotations marché INTRADAY (S&P/Nasdaq/VIX/pétrole). Fournisseur : finnhub (défaut) | twelvedata
MARKET_LIVE_PROVIDER=finnhub
# Finnhub (gratuit 60/min, inscription joignable) -> https://finnhub.io
FINNHUB_API_KEY=
# Twelve Data (gratuit 800/j) -> https://twelvedata.com (site parfois down)
TWELVEDATA_API_KEY=
# Symboles (défaut finnhub: SPY,QQQ,VIXY,USO ; twelvedata: SPX,IXIC,VIX,WTI)
# MARKET_LIVE_SYMBOLS=SPY,QQQ,VIXY,USO

# Calendrier économique RICHE (multi-pays, heure, impact, précédent/prévision/réel)
# Source : flux hebdo FairEconomy/ForexFactory — GRATUIT, AUCUNE CLÉ requise.
# Devises gardées (vide = toutes). Impact mini : low | medium | high
FF_CALENDAR_CURRENCIES=USD,EUR,GBP,JPY,CNY
FF_CALENDAR_MIN_IMPACT=medium

# --- Analyste IA (phase C) ---
# Port de l'API publique
API_PORT=3000
# Fournisseur principal : deepseek | gemini | groq. Fallback auto vers Groq si le principal échoue.
LLM_PROVIDER=deepseek
# Cadence de l'analyse IA de fond (heures) ; entre deux, déclenchement sur bascule
AI_BASELINE_HOURS=4
# Groq (palier gratuit, dispo UE) -> https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# DeepSeek (pas cher) -> https://platform.deepseek.com
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash