LOG_LEVEL=info

# Analyse fondamentale (phase B)
# FRED : clé gratuite -> https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# CoinGecko : clé "demo" optionnelle (relève le quota) -> https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# ACLED : conflits armés structurés. Pas de clé API : compte myACLED + OAuth.
# Crée un compte gratuit -> https://acleddata.com/register puis mets tes identifiants :
ACLED_EMAIL=
ACLED_PASSWORD=

# Cotations marché INTRADAY (S&P/Nasdaq/VIX/pétrole). Fournisseur : finnhub (défaut) | twelvedata
MARKET_LIVE_PROVIDER=finnhub
# Finnhub (gratuit 60/min, inscription joignable) -> https://finnhub.io
FINNHUB_API_KEY=
# Twelve Data (gratuit 800/j) -> https://twelvedata.com (site parfois down)
TWELVEDATA_API_KEY=
# Symboles (défaut finnhub: SPY,QQQ,VIXY,USO ; twelvedata: SPX,IXIC,VIX,WTI)
# MARKET_LIVE_SYMBOLS=SPY,QQQ,VIXY,USO

# Calendrier économique RICHE (multi-pays, heure, impact, précédent/prévision/réel)
# Source primaire : investing.com (scrapé, le RÉEL inclus) ; repli FairEconomy.
# GRATUIT, AUCUNE CLÉ requise.
# Devises gardées (vide = toutes). Impact mini : low | medium | high.
# Ces deux réglages s'appliquent à investing.com ET FairEconomy.
FF_CALENDAR_CURRENCIES=USD,EUR,GBP,JPY,CNY
FF_CALENDAR_MIN_IMPACT=medium
# Fenêtre investing.com : jours de passé (résultats publiés) → jours de futur (à venir).
# Élargis FUTURE_DAYS (ex. 40) pour capter les FOMC/échéances éloignées.
INVESTING_CAL_PAST_DAYS=2
INVESTING_CAL_FUTURE_DAYS=14

# Normalisation (z-score / percentile) : distributions calculées depuis l'historique
# des sources (FRED, CFTC, F&G), mises en cache dans data/baselines.json.
# Aucune clé en plus. Fenêtre d'historique (ans) et TTL du cache (heures).
BASELINE_WINDOW_YEARS=5
BASELINE_TTL_HOURS=24

# --- Analyste IA (phase C) ---
# Port de l'API publique
API_PORT=3000
# Fournisseur principal : deepseek | gemini | groq. Fallback auto vers Groq si le principal échoue.
LLM_PROVIDER=deepseek
# Cadence de l'analyse IA de fond (heures) ; entre deux, déclenchement sur bascule
AI_BASELINE_HOURS=4
# Groq (palier gratuit, dispo UE) -> https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# DeepSeek (pas cher) -> https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Webhook (SORTIE push du service) ---
# Quand l'IA produit un verdict (service en marche), POST JSON vers cette URL.
# Vide = push désactivé. N'importe quel service peut capter (bot, n8n, Zapier…).
WEBHOOK_URL=
# Si défini, le corps est signé en HMAC-SHA256 -> entête X-Signature-256: sha256=<hex>
WEBHOOK_SECRET=
# WEBHOOK_TIMEOUT_MS=10000

# --- Sécurité API (optionnelle ; utile si l'API est exposée hors localhost) ---
# Si défini, exige Authorization: Bearer <token> (ou ?token=) sur tout /api/* sauf /api/health.
API_TOKEN=
# Limite de requêtes par IP et par minute (0 ou vide = pas de limite).
API_RATE_LIMIT=